{
  "name": "desktop",
  "productName": "AGline",
  "version": "0.1.2",
  "private": true,
  "description": "AGline desktop ringer for Windows and macOS",
  "author": "AGline",
  "main": "dist/src/main.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "install-electron --no",
    "generate:assets": "node scripts/generate-assets.mjs",
    "build:ts": "tsc -p tsconfig.build.json",
    "dev": "pnpm generate:assets && pnpm build:ts && electron dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm generate:assets && pnpm build:ts && vitest run test/poller.test.ts test/security.test.ts test/credential-store.test.ts",
    "test:smoke": "pnpm generate:assets && pnpm build:ts && vitest run test/electron-smoke.test.ts",
    "pack": "pnpm generate:assets && pnpm build:ts && node scripts/run-builder.mjs --publish never",
    "pack:mac": "pnpm generate:assets && pnpm build:ts && node scripts/run-builder.mjs --mac dmg zip --universal --publish never",
    "pack:win": "pnpm generate:assets && pnpm build:ts && node scripts/run-builder.mjs --win nsis --x64 --arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "44.9.3",
    "electron-builder": "^26.0.12",
    "playwright": "^1.55.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "in.agline.desktop",
    "productName": "AGline",
    "directories": {
      "buildResources": "build",
      "output": "out"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "afterPack": "scripts/after-pack.cjs",
    "afterSign": "scripts/after-sign.cjs",
    "publish": [
      {
        "provider": "generic",
        "url": "https://agline.in/downloads/desktop/"
      }
    ],
    "protocols": [
      { "name": "AGline call link", "schemes": ["agline"] }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"],
      "icon": "icons/icon.icns",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "NSMicrophoneUsageDescription": "AGline can use your microphone for call replies when supported.",
        "NSUserNotificationsUsageDescription": "AGline shows incoming call alerts."
      }
    },
    "dmg": {
      "title": "AGline ${version}",
      "contents": [
        { "x": 130, "y": 190 },
        { "x": 410, "y": 190, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] }
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AGline"
    }
  }
}
